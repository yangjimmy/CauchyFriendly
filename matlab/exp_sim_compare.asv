clc; clear; close all;

% dataExp = load('.\data\pendulum_wall_0424_05_pos.mat');
dataExp = load('.\data\pendulum_0415_04_pos.mat');
load('.\data\pendulum_propagation_2state.mat')
dataSim2 = data;
load('.\data\pendulum_propagation_3state.mat')
dataSim3 = data;

%%
figure;
tiledlayout(2,1,'TileSpacing','tight');
nexttile;
plot(dataSim2.t, dataSim2.pos,'LineWidth',1.3); hold on;
plot(dataSim3.t, dataSim3.pos,'LineWidth',1.3); hold on;
plot(dataExp.t, dataExp.pos,'LineWidth',1.3); hold on;
ylabel('Pos [rad]','Interpreter','latex');
grid on;
% legend('Simulink','Experiment','Interpreter','latex', ...
%     'Fontsize',12,'Location','northeast');
legend('Simulink','Experiment','Interpreter','latex', ...
    'Fontsize',12,'Location','northeast');

nexttile;
plot(dataSim2.t, dataSim2.vel,'LineWidth',1.3); hold on;
plot(dataSim3.t, dataSim3.vel,'LineWidth',1.3); hold on;
plot(dataExp.t, dataExp.vel,'LineWidth',1.3); hold on;
xlabel('Time [s]','Interpreter','latex');
ylabel('Vel [rad/s]','Interpreter','latex');
grid on;

sgtitle('Simulation vs Experimental Result', ...
    'Interpreter','latex');



% exportgraphics(gcf,'.\fig\exp_sim_comparison.png','resolution',600);

